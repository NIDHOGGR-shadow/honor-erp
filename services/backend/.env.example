# Production template. Never commit the populated .env file.
HONOR_ENVIRONMENT=production
HONOR_DATABASE_URL=
HONOR_SESSION_SECRET=
HONOR_AUTH_PROVIDER=supabase
HONOR_SUPABASE_URL=
HONOR_SUPABASE_PUBLISHABLE_KEY=
HONOR_APP_ORIGIN=
HONOR_SHOP_ORIGIN=
HONOR_ALLOWED_ORIGINS=
HONOR_COOKIE_SECURE=true
# Payments start disabled. Select one eligible merchant provider after setup.
HONOR_PAYMENT_PROVIDER=disabled
HONOR_PAYMENT_SECRET=
HONOR_PAYMENT_WEBHOOK_SECRET=
HONOR_MERCHANT_COMPANY_ID=
HONOR_RESEND_API_KEY=
HONOR_EMAIL_FROM=
