{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "honor-erp",
  "main": "deploy/cloudflare/worker.mjs",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "keep_vars": true
}
